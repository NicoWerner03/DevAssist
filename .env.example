PORT=5000
LOG_LEVEL=info
DEV_ASSIST_MENTION=@dev-assist

# AI_PROVIDER=mock runs without external keys.
# AI_PROVIDER=opencode uses the local opencode CLI and the configured model.
AI_PROVIDER=mock
AI_MODEL=xai/grok-3-latest
AI_TIMEOUT_MS=120000
# AI_REASONING_EFFORT=medium

GITLAB_BASE_URL=https://gitlab.com
GITLAB_USE_GLAB=true
GITLAB_GLAB_HOSTNAME=
GITLAB_TOKEN=

# Optional webhook signature verification.
GITLAB_WEBHOOK_SIGNING_SECRET=
GITLAB_REQUIRE_SIGNATURE=false

GITLAB_WRITE_BACK=true
CONTEXT_OUTPUT_DIR=.dev-assist/issues
PROCESSING_DEDUP_TTL_MS=300000
